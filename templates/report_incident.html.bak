<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Report Incident | SafeShield</title>

    <link rel="stylesheet"
          href="{{ url_for('static', filename='style.css') }}">
</head>

<body>

<header class="topbar">
    <div>
        <h1>🛡️ SafeShield</h1>
        <p>Incident Reporting</p>
    </div>

    <a class="button secondary" href="{{ url_for('dashboard') }}">
        Dashboard
    </a>
</header>

<main class="container form-container">

    <section class="form-card">

        <h2>Report a Security Incident</h2>

        <p>This form records test reports on your computer.</p>

        {% with messages = get_flashed_messages(with_categories=true) %}
            {% for category, message in messages %}
                <div class="notice {{ category }}">{{ message }}</div>
            {% endfor %}
        {% endwith %}

        <form method="POST">

            <label for="incident_type">Incident Type</label>

            <select id="incident_type" name="incident_type" required>

                <option value="">Select an incident</option>

                {% for incident_type in incident_types %}
                    <option value="{{ incident_type }}">
                        {{ incident_type }}
                    </option>
                {% endfor %}

            </select>

            <label for="location">Incident Location</label>

            <input
                id="location"
                name="location"
                type="text"
                maxlength="200"
                placeholder="Enter the general location"
                required
            >

            <label for="description">Incident Details</label>

            <textarea
                id="description"
                name="description"
                rows="6"
                maxlength="2000"
                placeholder="Describe what happened"
                required
            ></textarea>

            <p class="help">
                Avoid unnecessary personal information.
                Reports are unverified until reviewed.
            </p>

            <button class="button primary" type="submit">
                Submit Test Report
            </button>

        </form>

    </section>

</main>

</body>
</html>
